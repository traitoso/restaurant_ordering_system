{
  "name": "restaurant_ordering_system",
  "version": "1.0.0",
  "description": "API REST de autoatendimento para restaurantes (categorias, produtos e pedidos) - Desenvolvimento Back-End, 4P Engenharia de Software",
  "keywords": [
    "back-end",
    "typescript",
    "express",
    "supabase",
    "api",
    "restaurant",
    "ordering"
  ],
  "homepage": "https://github.com/traitoso/restaurant_ordering_system#readme",
  "bugs": {
    "url": "https://github.com/traitoso/restaurant_ordering_system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/traitoso/restaurant_ordering_system.git"
  },
  "license": "ISC",
  "author": "Alisson de Oliveira da Silva",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env --import=tsx/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
